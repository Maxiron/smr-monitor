# SMR Safety Monitoring System Configuration

# Application Settings
APP_NAME="SMR Safety Monitoring System"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./smr_monitoring.db

# Email Configuration (Optional - leave blank to disable email alerts)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
MAIL_FROM=
MAIL_FROM_NAME="SMR Safety Monitoring"
ALERT_RECIPIENTS=["operator@example.com", "safety@example.com"]

# Monitoring Settings
DATA_COLLECTION_INTERVAL=1.0
ANOMALY_THRESHOLD=0.1
MAX_STORED_READINGS=1000
MAX_STORED_ALERTS=100

# ML Model Settings
MODEL_RETRAIN_INTERVAL=3600
TRAINING_DATA_SIZE=1000
